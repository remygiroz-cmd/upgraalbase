{
  "name": "MessageRead",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "ID du message"
    },
    "employee_id": {
      "type": "string",
      "description": "ID de l'employ\u00e9 (Personnel.id)"
    },
    "conversation_id": {
      "type": "string",
      "description": "ID de la conversation (pour requ\u00eates rapides)"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de lecture"
    }
  },
  "required": [
    "message_id",
    "employee_id",
    "conversation_id"
  ]
}