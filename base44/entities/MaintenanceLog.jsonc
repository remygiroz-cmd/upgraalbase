        "VIDANGE",
        "BATTERIE",
        "CONTROLE_TECHNIQUE",
        "AUTRE"
      ]
    },
    "description": {
      "type": "string"
    },
    "garage": {
      "type": "string"
    },
    "cout": {
      "type": "number"
    },
    "km_au_moment": {
      "type": "number"
    },
    "prochaine_echeance_km": {
      "type": "number"
    },
    "prochaine_echeance_date": {
      "type": "string",
      "format": "date"
    },
    "document_facture_url": {
      "type": "string"
    },
