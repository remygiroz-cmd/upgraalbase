{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "owner_employee_id": {
      "type": "string",
      "description": "ID de l'employ\u00e9 propri\u00e9taire de l'\u00e9v\u00e9nement"
    },
    "created_by_employee_id": {
      "type": "string",
      "description": "ID de l'employ\u00e9 qui a cr\u00e9\u00e9 l'\u00e9v\u00e9nement"
    },
    "title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement (max 80)"
    },
    "type": {
      "type": "string",
      "enum": [
        "INDISPO",
        "RDV",
        "FORMATION",
        "CONGE",
        "RAPPEL",
        "PERSO",
        "AUTRE"
      ],
      "default": "RDV",
      "description": "Type d'\u00e9v\u00e9nement"
    },
    "start_at": {
      "type": "string",
      "format": "date-time",
      "description": "D\u00e9but de l'\u00e9v\u00e9nement (UTC)"
    },
    "end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin de l'\u00e9v\u00e9nement (UTC)"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "description": "\u00c9v\u00e9nement toute la journ\u00e9e"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "TEAM",
        "INTERNAL"
      ],
      "default": "INTERNAL",
      "description": "Visibilit\u00e9 de l'\u00e9v\u00e9nement"
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "CANCELLED"
      ],
      "default": "CONFIRMED"
    },
    "importance": {
      "type": "string",
      "enum": [
        "NORMAL",
        "URGENT"
      ],
      "default": "NORMAL"
    },
    "location": {
      "type": "string",
      "description": "Lieu (max 120)"
    },
    "notes": {
      "type": "string",
      "description": "Notes (max 2000)"
    }
  },
  "required": [
    "owner_employee_id",
    "title",
    "start_at",
    "end_at"
  ]
}