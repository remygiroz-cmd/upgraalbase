{
  "name": "ChefMessage",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "Contenu du message"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "content",
    "date"
  ]
}